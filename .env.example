# Copy this file to `.env` (which is gitignored) and fill in your keys.
# Load it with: `set -a; source .env; set +a` (bash/zsh) or via `direnv allow`.

# Closed-weight providers — needed only for the providers you intend to use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=

# HuggingFace — needed for:
#   1. Gated models (Llama, Gemma)
#   2. Gated COMET-Kiwi (Unbabel/wmt22-cometkiwi-da)
# Get a token at https://huggingface.co/settings/tokens (read access is enough).
HF_TOKEN=

# Optional — local cache locations (uncomment and set if you want to override defaults)
# HF_HOME=~/.cache/huggingface
# TRANSFORMERS_CACHE=~/.cache/huggingface/transformers
